{
  // hvpf-2 (80/20 training + trained camera identification).
  // Run any step with: Terminal -> Run Task... (or Ctrl+Shift+P -> "Tasks: Run Task") -> pick the step.
  // Every task runs from the hvpf-2 folder with the project's .venv Python.
  // Steps 1-7 are not part of hvpf-2: it reuses the original project's splits, features and frames.
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": { "PYTHONUNBUFFERED": "1" }
  },
  "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
  "tasks": [
    {
      "label": "HVPF-2 · RUN ALL (background, ~5-6 h)",
      "type": "shell",
      "command": "mkdir -p data/logs && setsid nohup ./scripts/run_hvpf2.sh > data/logs/run_hvpf2.log 2>&1 < /dev/null & echo 'hvpf-2 started in the background. You can close VS Code. Follow it with task: HVPF-2 · progress'",
      "problemMatcher": []
    },
    {
      "label": "HVPF-2 · progress",
      "type": "shell",
      "command": "for f in models vit camera_id 08c_ensemble 09_evaluate report; do [ -f data/logs/$f.log ] && { echo \"== $f\"; tr '\\r' '\\n' < data/logs/$f.log | grep -v 'Warning\\|warn\\|^$' | tail -4; }; done; cat data/logs/run_hvpf2.log 2>/dev/null; pgrep -f 'run_hvpf[2].sh' > /dev/null && echo '>>> still running' || echo '>>> not running'",
      "problemMatcher": []
    },
    {
      "label": "0 · Check environment (GPU)",
      "type": "shell",
      "command": "nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader; ${workspaceFolder}/.venv/bin/python test_environment.py",
      "problemMatcher": []
    },
    {
      "label": "8 · Provenance models 80/20 (all 4 setups)",
      "type": "shell",
      "command": "for p in realistic controlled; do for s in fixed folds; do ${workspaceFolder}/.venv/bin/python scripts/08_models.py --protocol $p --scheme $s || exit 1; done; done",
      "problemMatcher": []
    },
    {
      "label": "8b · Vision Transformer 80/20 (GPU, ~4 h)",
      "type": "shell",
      "command": "for p in realistic controlled; do for s in fixed folds; do ${workspaceFolder}/.venv/bin/python scripts/08b_vit.py --protocol $p --scheme $s || exit 1; done; done",
      "problemMatcher": []
    },
    {
      "label": "10 · Camera identification by training (GPU, ~1 h)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/10_camera_id.py",
      "problemMatcher": []
    },
    {
      "label": "8c · Calibration + ensembles (after 8 and 8b)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/08c_ensemble.py",
      "problemMatcher": []
    },
    {
      "label": "9 · Evaluation (results tables)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/09_evaluate.py",
      "problemMatcher": []
    },
    {
      "label": "R · hvpf-2 report PDF",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/make_hvpf2_report.py && ~/.local/bin/tectonic -X compile report/results_hvpf2.tex",
      "problemMatcher": []
    }
  ]
}
