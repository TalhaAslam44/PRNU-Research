{
  // Use the project's own Python environment everywhere (terminal, Run button, tasks)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  // Large generated data: keep it out of search and the file watcher
  "files.watcherExclude": { "**/data/**": true, "**/.venv/**": true },
  "search.exclude": { "**/data/**": true, "**/.venv/**": true }
}
